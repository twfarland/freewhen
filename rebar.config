%% FreeWhen — ephemeral zero-trust meeting scheduler.
%% An umbrella of three layers; the dependency direction is one-way and enforced
%% by .claude/hooks/check_erl.escript and by xref. See docs/ARCHITECTURE.md.
%%
%%   fw_core   (pure domain: no processes, no JSON, no dependencies)
%%   fw_runtime(OTP adapters: rooms as processes, ids, limiter)
%%   fw_web    (cowboy adapters: HTTP, WebSocket, JSON, static client)

{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_export_vars,
    warn_unused_import,
    warn_untyped_record,
    warn_missing_spec
]}.

{deps, [{cowboy, "2.12.0"}]}.

{project_app_dirs, ["apps/*"]}.

{shell, [{apps, [fw_web]}, {config, "config/sys.config"}]}.

{dialyzer, [
    {warnings, [
        unknown,
        unmatched_returns,
        error_handling,
        extra_return,
        missing_return
    ]},
    {plt_apps, all_deps},
    {plt_extra_apps, [crypto, inets, ssl, public_key]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls
]}.

{cover_enabled, true}.
{cover_opts, [verbose]}.

{ct_opts, [{sys_config, "config/sys.config"}]}.

{profiles, [
    {test, [
        %% Test modules are exempt from -spec on every export; everything else
        %% in the strict list still applies. Profile opts are appended to the
        %% default ones and the last of a warn/nowarn pair wins, which is the
        %% only reason this cancellation works.
        {erl_opts, [nowarn_missing_spec]},
        {deps, [{gun, "2.1.0"}]}
    ]},
    {prod, [
        {relx, [{mode, prod}, {include_erts, true}, {debug_info, strip}]}
    ]}
]}.

{relx, [
    {release, {freewhen, "0.1.0"}, [
        sasl,
        fw_core,
        fw_runtime,
        fw_web
    ]},
    {mode, dev},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"},
    {extended_start_script, true}
]}.
