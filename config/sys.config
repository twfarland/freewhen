%% Every value here is an operational knob. Nothing in this file is a secret,
%% because FreeWhen holds no secrets that outlive a room.
[
    {fw_runtime, [
        %% A room dies this long after the *last change to it*, not after
        %% creation. Arranging a meeting between organisations can take weeks,
        %% and a room that expired mid-negotiation would be worse than useless.
        %% 30 days. Must stay under erlang:send_after/3's 49-day ceiling.
        {room_idle_ms, 2592000000},
        %% Once a slot is picked the room is settled and stops being a
        %% negotiation, so it runs out this instead of the idle window. A day,
        %% not minutes: with coordination spread over weeks, most people are
        %% not watching when the host chooses, and they still need to see what
        %% was decided and download the invitation.
        {finalize_grace_ms, 86400000},
        %% Memory-exhaustion ceilings. Both are refusals, never evictions:
        %% an existing room is never sacrificed to admit a new one.
        %%
        %% Measured with bench/load.escript, not calculated: a live room costs
        %% 12.4 kB with eight ordinary answers and 58.8 kB with sixteen
        %% maximally fragmented ones. Most of the floor is the process itself
        %% — heap, directory entry, monitors, timer — which an earlier estimate
        %% based on term size missed by about 4x.
        %%
        %% Rooms live on idleness, so this ceiling holds a *month* of them
        %% rather than a day: 20000 is roughly 660 new rooms a day sustained.
        %% That is 242 MB in ordinary use and about 1.15 GB against crafted
        %% input, which is what MemoryMax=2G in the systemd unit is sized for.
        {max_rooms, 20000},
        {max_attendees_per_room, 16},
        %% Token bucket per client address for POST /api/rooms.
        {create_bucket, #{capacity => 10, refill_per_sec => 1, cost => 10}},
        %% Rooms are written down only if FW_SNAPSHOT_FILE points somewhere
        %% durable. Unset, `fw_snapshots_none` is used and a restart loses
        %% every room.
        {snapshot_file, "/var/lib/freewhen/rooms.dets"}
    ]},

    {fw_web, [
        %% PORT, FW_BIND and FW_ALLOWED_ORIGINS override these from the
        %% environment. `any` is every interface; deployed behind a proxy on
        %% the same host, FW_BIND is 127.0.0.1 so that nothing else can reach
        %% the node and `x-forwarded-for` means something.
        {port, 8080},
        {bind, any},
        {max_frame_bytes, 65536},
        {idle_timeout_ms, 60000},
        %% `any` accepts every Origin (development). In production set a list of
        %% binaries; a client that sends no Origin is then rejected.
        {allowed_origins, any}
    ]},

    {kernel, [
        {logger_level, info},
        {logger, [
            {handler, default, logger_std_h, #{
                formatter =>
                    {logger_formatter, #{
                        single_line => true,
                        legacy_header => false,
                        template => [time, " ", level, " ", msg, "\n"]
                    }}
            }}
        ]}
    ]}
].
